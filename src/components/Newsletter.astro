---
// Set PUBLIC_NEWSLETTER_ACTION in a .env file (or in Cloudflare Pages settings)
// to the form-post URL your newsletter service gives you. Until then the
// button stays disabled so nobody submits into the void.
const action = import.meta.env.PUBLIC_NEWSLETTER_ACTION as string | undefined;
---

<section class="news" id="newsletter">
  <h2>One small pause, in your inbox.</h2>
  <p>New posts, tools, and book picks, whenever there's something worth sharing.</p>
  <form method="post" action={action ?? '#'}>
    <div class="row">
      <label for="email">Email address</label>
      <input class="field" id="email" name="email" type="email" placeholder="you@example.com" required />
    </div>
    <button class="btn" type="submit" disabled={!action}>Subscribe</button>
  </form>
  {!action && <p class="note">Signup opens soon.</p>}
</section>

<style>
  .news {
    padding: 96px var(--gutter);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
    text-align: center;
  }
  h2 {
    font-size: clamp(34px, 5vw, 48px);
    line-height: 1.1;
    max-width: 640px;
  }
  p {
    margin: 0;
    font-size: 18px;
    max-width: 460px;
  }
  form {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: flex-end;
    justify-content: center;
    width: 100%;
  }
  .row {
    display: flex;
    flex-direction: column;
    gap: 6px;
    text-align: left;
    width: min(300px, 100%);
  }
  label {
    font-size: 13px;
    font-weight: 600;
  }
  .btn[disabled] {
    opacity: 0.55;
    cursor: not-allowed;
  }
  .note {
    font-size: 14px;
  }
</style>
