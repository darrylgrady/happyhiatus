---
const year = new Date().getFullYear();
---

<footer class="footer wrap">
  <span class="mark">Happy Hiatus</span>
  <span>Take the break. &copy; {year}</span>
</footer>

<style>
  .footer {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: space-between;
    padding: 32px var(--gutter) 48px;
    border-top: 1px solid rgba(43, 42, 36, 0.2);
    font-size: 14px;
  }
  .mark {
    font-family: var(--font-display);
    font-size: 18px;
  }
</style>
