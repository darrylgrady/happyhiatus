---
import Base from '../../layouts/Base.astro';
import BreathingTimer from '../../components/BreathingTimer.astro';
---

<Base title="Breathing timer" description="Pick a rhythm, press start, and follow the circle.">
  <div class="wrap crumbs">
    <a href="/">Home</a><span aria-hidden="true">/</span><a href="/tools">Tools</a><span aria-hidden="true">/</span><span
      >Breathing timer</span
    >
  </div>

  <header class="wrap head">
    <div class="titles">
      <span class="eyebrow">Tool · Breathe</span>
      <h1>Breathing timer</h1>
    </div>
    <p>Pick a rhythm, press start, and follow the circle. It grows as you breathe in and shrinks as you breathe out.</p>
  </header>

  <div class="wrap pad">
    <BreathingTimer />
  </div>

  <section class="wrap how">
    <h2>How it works</h2>
    <div class="steps">
      <div>
        <span class="n">01</span>
        <h3>Choose a rhythm</h3>
        <p>Calm is a gentle default. Box keeps every count even. 4-7-8 slows things down for winding down.</p>
      </div>
      <div>
        <span class="n">02</span>
        <h3>Follow the circle</h3>
        <p>
          Breathe in as it grows, hold while it rests, and breathe out as it shrinks. The number counts the seconds left
          in each step.
        </p>
      </div>
      <div>
        <span class="n">03</span>
        <h3>Stay as long as you like</h3>
        <p>There is no timer to beat. Stop whenever you feel ready, and come back any time.</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 0 var(--gutter) 20px;
    font-size: 14px;
    font-weight: 500;
    color: var(--fern);
  }
  .crumbs span:last-child {
    color: var(--ink);
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    gap: 24px 56px;
    align-items: flex-end;
    justify-content: space-between;
    padding: 40px var(--gutter) 48px;
  }
  .titles {
    flex: 1 1 440px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  h1 {
    font-size: clamp(48px, 8vw, 80px);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .head p {
    flex: 1 1 320px;
    max-width: 440px;
    margin: 0;
    font-size: 19px;
  }
  .pad {
    padding: 0 var(--gutter);
  }
  .how {
    padding: 88px var(--gutter) 96px;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .how h2 {
    font-size: 44px;
  }
  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 32px;
  }
  .steps > div {
    border-top: 1px solid rgba(43, 42, 36, 0.35);
    padding-top: 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .n {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 18px;
  }
  .steps h3 {
    font-size: 28px;
  }
  .steps p {
    margin: 0;
  }
</style>
