---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import Newsletter from '../components/Newsletter.astro';
import { categories, getCategory } from '../data/categories';
import { tools } from '../data/tools';
import { books } from '../data/books';
import { getPosts } from '../lib/posts';

export function getStaticPaths() {
  return categories.map((c) => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const category = getCategory(slug!)!;
const posts = (await getPosts()).filter((p) => p.data.category === category.slug);
const categoryTools = tools.filter((t) => t.category === category.slug);
const categoryBooks = books.filter((b) => b.category === category.slug);
const light = category.dark;
---

<Base title={category.name} description={category.intro}>
  <div class="wrap crumbs">
    <a href="/">Home</a><span aria-hidden="true">/</span><span>{category.name}</span>
  </div>

  <section class:list={['hero', { light }]} style={`background:${category.bg}`}>
    <div class="wrap inner">
      <div class="title">
        <span class="num">{category.number} · Category</span>
        <h1>{category.name}</h1>
        <p>{category.intro}</p>
      </div>
      <ul class="items">
        {category.items.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <div class="wrap">
    <section class="section">
      <h2>From the journal</h2>
      {
        posts.length > 0 ? (
          <div class="grid">
            {posts.map((post) => (
              <PostCard post={post} />
            ))}
          </div>
        ) : (
          <p class="empty">Posts for {category.name} are on the way.</p>
        )
      }
    </section>

    {
      categoryTools.length > 0 && (
        <section class="section tools">
          <h2>Tools</h2>
          <div class="grid">
            {categoryTools.map((t) => (
              <div class="tool">
                <span class="label">{t.status === 'live' ? 'Tool' : 'Coming soon'}</span>
                <h3>{t.name}</h3>
                <p>{t.blurb}</p>
                {t.status === 'live' && (
                  <a class="btn light" href={`/tools/${t.slug}`}>
                    Open
                  </a>
                )}
              </div>
            ))}
          </div>
        </section>
      )
    }

    {
      categoryBooks.length > 0 && (
        <section class="section">
          <div class="row">
            <h2>On the bookshelf</h2>
            <a class="more" href="/bookshelf">See the full bookshelf</a>
          </div>
          <div class="books">
            {categoryBooks.map((b) => (
              <div class="book">
                <div class="cover" style={`background:${b.cover}`}></div>
                <div>
                  <h3>{b.title}</h3>
                  <span class="by">{b.author}</span>
                  <p>{b.note}</p>
                </div>
              </div>
            ))}
          </div>
        </section>
      )
    }

    <Newsletter />
  </div>
</Base>

<style>
  .crumbs {
    display: flex;
    gap: 8px;
    padding: 0 var(--gutter) 20px;
    font-size: 14px;
    font-weight: 500;
    color: var(--fern);
  }
  .crumbs span:last-child {
    color: var(--ink);
  }
  .hero {
    padding: 72px 0 80px;
  }
  .hero.light {
    color: var(--oat);
  }
  .inner {
    padding: 0 var(--gutter);
    display: flex;
    flex-wrap: wrap;
    gap: 56px;
    align-items: flex-end;
  }
  .title {
    flex: 1 1 440px;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .num {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 20px;
  }
  h1 {
    font-size: clamp(72px, 12vw, 148px);
    line-height: 0.95;
    letter-spacing: -0.03em;
  }
  .title p {
    margin: 0;
    font-size: 21px;
    max-width: 500px;
  }
  .items {
    flex: 1 1 380px;
    max-width: 520px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-display);
    font-size: 28px;
  }
  .items li {
    padding: 20px 0;
    border-top: 1px solid rgba(43, 42, 36, 0.35);
  }
  .items li:last-child {
    border-bottom: 1px solid rgba(43, 42, 36, 0.35);
  }
  .light .items li {
    border-color: rgba(244, 238, 227, 0.4);
  }
  .section {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }
  .section h2 {
    font-size: 44px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 24px;
  }
  .empty {
    margin: 0;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: baseline;
    justify-content: space-between;
  }
  .more {
    font-weight: 600;
    font-size: 15px;
    color: var(--clay);
  }
  .tool {
    background: var(--moss);
    color: var(--oat);
    padding: 32px;
    border-radius: var(--radius-card);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }
  .tool .label {
    color: var(--blush);
  }
  .tool h3 {
    font-size: 32px;
  }
  .tool p {
    margin: 0;
  }
  .books {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 28px;
  }
  .book {
    display: flex;
    gap: 20px;
    align-items: flex-start;
  }
  .cover {
    flex: 0 0 112px;
    height: 160px;
    border-radius: 3px 6px 6px 3px;
    box-shadow: inset 6px 0 0 rgba(43, 42, 36, 0.25);
  }
  .book h3 {
    font-size: 23px;
    line-height: 1.2;
  }
  .by {
    font-size: 14px;
  }
  .book p {
    margin: 8px 0 0;
    font-size: 14px;
  }
</style>
