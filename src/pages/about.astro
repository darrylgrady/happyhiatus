---
import Base from '../layouts/Base.astro';
import Newsletter from '../components/Newsletter.astro';
---

<Base title="About" description="Why Happy Hiatus exists.">
  <div class="wrap">
    <header class="head">
      <span class="eyebrow">About</span>
      <h1>Why Happy Hiatus</h1>
    </header>
    <article class="prose">
      <p>[Your story in a few short paragraphs: why you started Happy Hiatus, what a happy hiatus means to you, and what readers can expect here.]</p>
      <p>[A line or two about your background, such as your happiness coach certification, if you want to share it.]</p>
    </article>
    <Newsletter />
  </div>
</Base>

<style>
  .head {
    padding: 40px var(--gutter) 40px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  h1 {
    font-size: clamp(48px, 8vw, 80px);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .prose {
    max-width: 760px;
    padding: 0 var(--gutter) 48px;
    font-size: 19px;
    line-height: 1.75;
  }
</style>
